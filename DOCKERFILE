FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV PARTICLETRACKER_DATA=/opt/particletracker/testdata
ENV QT_X11_NO_MITSHM=1
ENV PATH="/opt/particletracker/.venv/bin:$PATH"

WORKDIR /opt/particletracker

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential git ffmpeg ca-certificates \
    libgl1 libglib2.0-0 libsm6 libxext6 libxrender1 libx11-6 \
    libx11-xcb1 libxcb1 libxcb-glx0 libxcb-image0 libxcb-keysyms1 \
    libxcb-randr0 libxcb-render-util0 libxcb-shm0 libxcb-sync0 \
    libxcb-xfixes0 libxcb-xinerama0 libxcb-xkb1 libxkbcommon-x11-0 \
    libfontconfig1 libxrandr2 libxcursor1 libxdamage1 libxcomposite1 \
    libpulse0 libdbus-1-3 libxss1 \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md license.txt ./
COPY src ./src
COPY testdata ./testdata

RUN uv sync --frozen --no-dev

RUN mkdir -p /data
VOLUME ["/data"]

CMD ["uv", "run", "python", "-c", "from particletracker import track_gui; track_gui()"]